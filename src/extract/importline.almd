// 計器: import 行を読む。言語ごとの形だけ。

fn cut_at(s: String, sep: String) -> String = match string.index_of(s, sep) {
  some(i) => string.trim(string.slice(s, 0, i)),
  none => string.trim(s),
}

fn quoted(t: String) -> Option[String] = match string.index_of(t, "\"") {
  some(a) => {
    let rest = string.drop(t, a + 1)
    option.map(string.index_of(rest, "\""), (b) => string.slice(rest, 0, b))
  },
  none => none,
}

fn go_imports(lines: List[String]) -> List[String] = {
  var out: List[String] = []
  var inblock = false
  for l in lines {
    let t = string.trim(l)
    if t == "import (" then inblock = true
    else if inblock and t == ")" then inblock = false
    else if inblock or string.starts_with(t, "import ") then
      match quoted(t) { some(s) => list.push(out, s), none => () }
    else ()
  }
  out
}

// 2つ以上の枝に some(呼び出し) を置かないのは almide/almide#2655 の回避。almide 0.62.0 の wasm の test が
// rc_dec の unreachable に落ちる（0.63.1 では直っている）。枝には数か let に受けた値だけを置き、some で包むのは1か所にする。
fn rust_import(t: String) -> Option[String] = {
  let prefix = if string.starts_with(t, "pub(crate) use ") then 15
    else if string.starts_with(t, "pub use ") then 8
    else if string.starts_with(t, "use ") then 4
    else 0
  if prefix == 0 then none else {
    let head = cut_at(cut_at(string.drop(t, prefix), ";"), "{")
    let name = string.strip_suffix(head, "::") ?? head
    some(name)
  }
}

fn py_import(t: String) -> Option[String] =
  if string.starts_with(t, "import ") then { let name = cut_at(cut_at(string.drop(t, 7), ","), " "); some(name) }
  else if string.starts_with(t, "from ") then { let name = cut_at(string.drop(t, 5), " "); some(name) }
  else none

fn almd_import(t: String) -> Option[String] =
  if string.starts_with(t, "import ") then { let name = cut_at(string.drop(t, 7), " "); some(name) } else none

fn imports_of(lang: String, text: String) -> List[String] = {
  let lines = string.lines(text)
  match lang {
    "go" => go_imports(lines),
    "rust" => list.filter_map(lines, (l) => rust_import(string.trim(l))),
    "python" => list.filter_map(lines, (l) => py_import(string.trim(l))),
    "almide" => list.filter_map(lines, (l) => almd_import(string.trim(l))),
    _ => [],
  }
}
