// 眼 6: コミット。1 箱が正、2 箱は告げる、3 箱で落とす。
import self.vocab.finding
import self.vocab.thresholds
import self.checks.resolve

mod fn has_prefix(subject: String) -> Bool = {
  let head = string.to_lower(list.get(string.split(subject, ":"), 0) ?? "")
  let word = list.get(string.split(head, "("), 0) ?? ""
  string.contains(subject, ":") and list.contains(["feat", "fix", "chore", "docs", "refactor", "test", "build", "ci", "perf", "style"], string.replace(word, "!", ""))
}

fn check(changed: List[String], subject: String, dirs: List[(String, String)], th: thresholds.Thresholds) -> List[finding.Finding] = {
  let boxes = list.map(changed, (f) => resolve.box_of(f, dirs)) |> list.filter((b) => b != "") |> list.sort |> list.dedup
  let n = list.len(boxes)
  let msg = int.to_string(n) + " 箱を同時に触っている（" + list.join(boxes, ", ") + "）"
  let a = if n > th.commit_boxes_max then [finding.fail("commit", "", "-", msg)]
    else if n == th.commit_boxes_max then [finding.warn("commit", "", "-", msg)]
    else []
  let b = if subject != "" and has_prefix(subject) then [finding.warn("commit", "", "-", "件名が接頭辞で始まる。理由を 1 文で")] else []
  a + b
}

test "three boxes fail, prefix warns" {
  let dirs = [("model", "model"), ("meter", "meter"), ("cli", "cli")]
  let out = check(["model/a.go", "meter/b.go", "cli/c.go"], "feat: x", dirs, thresholds.defaults())
  assert_eq(list.len(list.filter(out, finding.is_fail)), 1)
  assert_eq(list.len(out), 2)
  assert_eq(list.len(check(["model/a.go"], "Split the box_name", dirs, thresholds.defaults())), 0)
}
