// 契約テスト: 本物の出力が偽物と同じ形。本物が呼べないときは err の文言をそのまま見せる。
import self.gramide.probe
import self.gramide.fakeprobe

test "symbols and tags have the fake's shape" {
  match probe.symbols("spec/mixed/meter/meter.go") {
    ok(real) => assert_eq(string.contains(real, "\"symbols\":["), true),
    err(e) => assert_eq(e, ""),
  }
  assert_eq(string.contains(fakeprobe.symbols(["a"]), "\"symbols\":["), true)
  match probe.tags("spec/mixed/meter/meter.go") {
    ok(real) => assert_eq(string.starts_with(real, "def "), true),
    err(e) => assert_eq(e, ""),
  }
  assert_eq(string.starts_with(fakeprobe.tags(["os.Getenv"]), "ref call "), true)
}
